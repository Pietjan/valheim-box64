# Copy to ~/.config/valheim/valheim.env (rootless) or /etc/valheim/valheim.env
# (rootful) and chmod 0600 — this file holds the server password.
#
# No quotes, no spaces around =. systemd EnvironmentFile takes values verbatim.

VALHEIM_NAME=My Valheim Server
VALHEIM_WORLD=Dedicated
VALHEIM_PASSWORD=changeme

# The password must be at least 5 characters and must not appear in the server
# or world name, or the server refuses to start.
